# @gram/functions-sdk SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: GRAM_
#
# Security environment variables:
GRAM_APIKEY_HEADER_GRAM_KEY=your_apikey_header_gram-key_here
GRAM_PROJECT_SLUG_HEADER_GRAM_PROJECT=your_project_slug_header_gram-project_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
GRAM_DEBUG=true
